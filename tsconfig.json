{
  "compilerOptions": {
    "target": "ESNext", // 指定编译后的 JavaScript 版本
    "useDefineForClassFields": true, // 强制类字段使用 Object.defineProperty
    "module": "ESNext", // 指定生成的模块系统
    "moduleResolution": "bundler", // 现代构建工具（如 Vite）推荐的模块解析策略
    "strict": true, // 开启所有严格类型检查选项
    "jsx": "preserve", // 在 .tsx 文件中保留 JSX，交给 Vite 处理
    "importHelpers": true, // 引入辅助库以减少生成的代码体积
    "experimentalDecorators": true, // 启用实验性的装饰器支持
    "allowSyntheticDefaultImports": true, // 允许从没有默认导出的模块中默认导入
    "sourceMap": true, // 生成 source map 文件，方便调试
    "resolveJsonModule": true, // 允许导入 .json 文件
    "isolatedModules": true, // 确保每个文件都可以安全地转译，而不依赖其他文件
    "esModuleInterop": true, // 允许使用 CommonJS 模块的默认导入
    "lib": ["ESNext", "DOM", "DOM.Iterable"], // 编译时需要包含的库文件
    "skipLibCheck": true, // 跳过库文件的类型检查，加快编译速度
    "noEmit": true, // 不生成输出文件，只进行类型检查
    "paths": {
      "@/*": ["./src/*"] // 配置路径别名，将 @ 映射到 src 目录
    },
    "types": [
      "vite/client", // Vite 客户端类型定义
      "unplugin-icons/types/vue", // 图标插件类型定义
      "element-plus/global" // Element Plus 全局组件类型定义
    ]
  },
  "include": [
    "src/**/*.ts", // 包含 src 目录下所有 ts 文件
    "src/**/*.d.ts", // 包含所有类型声明文件
    "src/**/*.tsx", // 包含所有 tsx 文件
    "src/**/*.vue", // 包含所有 vue 文件
    "mock/**/*.ts" // 包含 mock 目录下所有 ts 文件
  ],
  "exclude": ["node_modules", "dist"], // 排除 node_modules 和打包输出目录
  "references": [{ "path": "./tsconfig.node.json" }] // 引用针对 Node 环境的 TS 配置
}
